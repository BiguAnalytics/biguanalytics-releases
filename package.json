{
  "name": "biguanalytics",
  "version": "1.0.0",
  "description": "Rugby match analysis tool for Bigua Rugby Club",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "server:install": "npm --prefix server ci --omit=dev",
    "postinstall": "npm run server:install",
    "pretest": "npm run server:install",
    "test": "vitest run",
    "pretest:watch": "npm run server:install",
    "test:watch": "vitest",
    "preserver": "npm run server:install",
    "server": "npm --prefix server run server",
    "test:perf:timeline": "vitest run src/renderer/components/__tests__/timeline.test.js",
    "check:ai-secrets": "node scripts/check-ai-client-secrets.js",
    "check:windows-build": "node scripts/check-windows-build.js",
    "security:check": "node scripts/check-secrets.js && node scripts/check-ai-client-secrets.js",
    "build": "electron-builder"
  },
  "author": "Bigua Rugby Club",
  "license": "UNLICENSED",
  "private": true,
  "build": {
    "appId": "com.biguanalytics.app",
    "productName": "BiguAnalytics",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "buildResources": "build"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "files": [
      "src/**/*",
      "!src/**/__tests__/**",
      "!src/**/*.test.js",
      "!server/**",
      "!backend/**",
      "!docs/**",
      "!supabase/**",
      "!node_modules/supabase/**",
      "!node_modules/@supabase/cli-*/**",
      "!scripts/**",
      "!.env*",
      "package.json",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "signExts": [
        "!.exe",
        "!.dll",
        "!.node"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "BiguAnalytics"
    }
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.0.0",
    "resedit": "^1.7.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "chart.js": "^4.5.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.2.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "supabase": "^2.105.0",
    "uuid": "^11.1.0"
  }
}
